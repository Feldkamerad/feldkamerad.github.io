# ============================================================
#  GartenAI – Beispiel für die .env Datei
# ============================================================
#  1. Diese Datei nach ".env" kopieren:  cp .env.example .env
#  2. Die Werte unten mit deinen eigenen Keys ersetzen.
#  3. Die .env Datei wird durch .gitignore geschützt und
#     NIEMALS auf GitHub hochgeladen.
#
#  WICHTIG: Bei Vite müssen alle Variablen mit "VITE_" beginnen,
#  sonst sind sie im Code (import.meta.env) nicht sichtbar.
# ============================================================

# --- Google Gemini (Pflanzen-/Krankheitserkennung, Analysen) ---
# Kostenlosen Key holen unter: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=hier_deinen_gemini_key_einfuegen

# --- Firebase Firestore ("Mein Betrieb" speichern) ---
# Werte aus der Firebase Console > Projekteinstellungen > Web-App.
# OPTIONAL: Ohne diese Werte funktioniert die App trotzdem –
# "Mein Betrieb" speichert dann nur lokal im Browser (localStorage).
VITE_FIREBASE_API_KEY=hier_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dein-projekt-id
VITE_FIREBASE_STORAGE_BUCKET=dein-projekt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Open-Meteo (Wetter) braucht KEINEN API Key – komplett kostenlos.
